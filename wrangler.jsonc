{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fifty-years-beyond-earth",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-12",
	"observability": {
		"enabled": true
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"previews": {}
}
